# ============================================================================
# meeting-summary :: variables de entorno
# Copia este archivo a .env y ajusta los valores.
# ============================================================================

# --- Autenticación del celular (token Bearer estático) ----------------------
# Genera uno fuerte, p.ej.:  openssl rand -hex 32
APP_TOKEN=cambia-esto-por-un-token-largo-y-secreto

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=meeting
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=meeting_summary
# Host/puerto tal como los ve el backend dentro de la red de docker-compose
DATABASE_URL=postgresql+psycopg2://meeting:cambia-esta-password@db:5432/meeting_summary

# --- Transcripción (faster-whisper, CPU) ------------------------------------
# Modelo: tiny | base | small | medium | large-v3   (por defecto: medium)
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_LANGUAGE=es
# 0 = descarga el modelo en el primer arranque (necesita internet).
# 1 = usa solo el modelo ya cacheado (ponlo en 1 tras la primera descarga,
#     o si HF te limita la descarga y precargas la caché manualmente).
HF_HUB_OFFLINE=0

# --- Resumen con Claude (Claude Code CLI headless) --------------------------
# Ruta del binario de Claude Code dentro del contenedor del worker
CLAUDE_BIN=claude
CLAUDE_MODEL=opus
# Timeout en segundos para la llamada de resumen
CLAUDE_TIMEOUT=600
# Autenticación de la suscripción SIN login interactivo: genera el token en tu
# máquina con `claude setup-token` y pégalo aquí. Si lo dejas vacío, el worker
# usará el login guardado en el volumen (docker compose exec worker claude -> /login).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Almacenamiento ---------------------------------------------------------
# Carpeta donde viven los audios y entregables (bind mount a /opt/recordings)
RECORDINGS_DIR=/opt/recordings

# --- API --------------------------------------------------------------------
API_PORT=8080
